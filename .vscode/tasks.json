{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build",
      "problemMatcher": "$rustc",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "cargo build (btb-motion bez optymalizacji)",
      "type": "shell",
      "command": "cargo build --config 'profile.dev.package.btb-motion.opt-level=0'",
      "problemMatcher": "$rustc"
    },
    {
      "label": "make check",
      "type": "shell",
      "command": "make check",
      "problemMatcher": "$rustc",
      "group": "test"
    }
  ]
}
